{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hands mod.json",
  "description": "What Herdr reads from Hands's mod.json, and the settings it takes.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's schema, for editors."
    },
    "version": {
      "type": "string",
      "description": "The mod's version."
    },
    "title": {
      "type": "string",
      "description": "The mod's name, as Herdr shows it."
    },
    "place": {
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "none"
      ],
      "description": "Where Herdr first docks the mod. \"none\": only where a layout or another mod puts it."
    },
    "size": {
      "type": "number",
      "minimum": 0,
      "description": "Its first size, in pixels."
    },
    "focusable": {
      "type": "boolean",
      "description": "Lets pane.go give a shown copy the keyboard."
    },
    "overlay": {
      "type": "object",
      "description": "How mod.open shows it.",
      "properties": {
        "kind": {
          "enum": [
            "dialog",
            "popup",
            "window"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "settings": {
      "type": "object",
      "description": "Your changes. A setting left out uses its default.",
      "additionalProperties": false,
      "properties": {
        "pause": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "after_action": {
              "title": "Pause after an action",
              "description": "The wait before an action command returns. --delay overrides it for one call.",
              "type": [
                "string",
                "integer"
              ],
              "format": "duration",
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s|m|h)\\s*$",
              "default": "500ms"
            },
            "between_keys": {
              "title": "Pause between keys",
              "description": "The pause between typed characters. --key-delay overrides it for one call.",
              "type": [
                "string",
                "integer"
              ],
              "format": "duration",
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s|m|h)\\s*$",
              "default": "100ms"
            }
          }
        },
        "see": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_lines": {
              "title": "Lines listed",
              "description": "The most elements a listing shows. --max overrides it.",
              "type": "integer",
              "minimum": 1,
              "x-step": 50,
              "default": 300
            },
            "max_depth": {
              "title": "Listing depth",
              "description": "How deep a listing goes. --depth overrides it.",
              "type": "integer",
              "minimum": 1,
              "x-step": 5,
              "default": 60
            }
          }
        },
        "record": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "frames_per_second": {
              "title": "Recording frame rate",
              "description": "Frames per second for window recordings.",
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "x-step": 5,
              "x-unit": "fps",
              "default": 30
            }
          }
        },
        "pane": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "refresh": {
              "title": "Pane refresh",
              "description": "How often the pane checks for new captures and actions.",
              "type": [
                "string",
                "integer"
              ],
              "format": "duration",
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s|m|h)\\s*$",
              "default": "5s"
            }
          }
        },
        "state_dir": {
          "title": "State folder",
          "description": "Where snapshots and recordings are kept. HANDS_STATE_DIR wins over it.",
          "type": "string",
          "default": "~/Library/Caches/hands"
        }
      }
    }
  }
}
