{
  "version": "1.2.0",
  "place": "none",
  "title": "Branch PR",
  "settings": {
    "refresh": {
      "every": "60s",
      "search_debounce": "450ms"
    },
    "list": {
      "page_size": 25,
      "default": {
        "tab": "all",
        "state": "open"
      }
    },
    "worktrees": {
      "root": "~/.herdr/worktrees",
      "open_with": "terminal"
    },
    "logs": {
      "keep_last": "60KB"
    },
    "tools": {
      "github": "gh",
      "gitlab": "glab"
    }
  }
}
